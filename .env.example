# Copy to .env. Never commit real keys.
LLM_API_KEY=
# DEEPSEEK_API_KEY from the shell is also supported.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# Optional local model directory; no model files are committed.
EMBEDDING_MODEL_PATH=
DATA_DIR=./data
# 混合检索开关：开=BGE+BM25 融合，关=单独 BGE。两条路线都会用 cross-encoder 重排。
HYBRID_SEARCH=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 召回/融合后进入重排的候选条数；最终交给生成的片段数由 TOP_K 控制。
RERANK_TOP_N=20
TOP_K=6
